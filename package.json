{
  "name": "ricecal",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "check": "turbo typecheck test && biome check .",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset --local",
    "db:diff": "supabase db diff -f",
    "db:test": "supabase test db",
    "db:types": "node --no-warnings supabase/scripts/gen-types.mjs",
    "db:seed:catalogue": "node --experimental-strip-types --no-warnings --import ./supabase/scripts/register-ts.mjs supabase/scripts/gen-catalogue-sql.mjs",
    "eas": "pnpm --filter @ricecal/mobile exec eas",
    "eas:credentials": "pnpm --filter @ricecal/mobile exec eas credentials",
    "expo": "pnpm --filter @ricecal/mobile exec expo",
    "start": "pnpm --filter @ricecal/mobile exec expo start --dev-client",
    "build:android": "pnpm --filter @ricecal/mobile exec eas build --profile development --platform android",
    "build:ios": "pnpm --filter @ricecal/mobile exec eas build --profile development --platform ios"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@sentry/cli",
      "@shopify/react-native-skia",
      "dtrace-provider",
      "esbuild",
      "unrs-resolver",
      "workerd"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "eas-cli": "^21.4.0",
    "supabase": "^2.110.0",
    "turbo": "^2.10.7",
    "typescript": "^6.0.3",
    "wrangler": "^4.114.0"
  }
}
