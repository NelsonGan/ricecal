{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["web:dev"],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "web-preview",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@ricecal/web", "start"],
      "port": 3000
    },
    {
      "name": "app-studio",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["studio:dev"],
      "port": 3001
    }
  ]
}
