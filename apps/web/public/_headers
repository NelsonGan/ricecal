# Hashed build output, so it can be cached until the heat death of the universe.
# Every other route's caching is decided by vinext and passed through as-is.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# These font filenames also carry their content fingerprint.
/fonts/*.woff2
  Cache-Control: public, max-age=31536000, immutable
