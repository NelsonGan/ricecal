{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ricecal-catalogue",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  // The catalogue is read-only and read-heavy, so the Worker wants to run where
  // the data is rather than where the caller is. The database was created with
  // the APAC location hint; Smart Placement moves the Worker to meet it.
  "placement": { "mode": "smart" },
  "observability": { "enabled": true },
  // The public hostname, on our own domain rather than `workers.dev`.
  //
  // A ROUTE rather than a custom domain, and the reason is which credential can
  // do what: a custom domain writes the zone's DNS itself, so it needs one
  // token holding both DNS edit and Workers edit. A route needs only Workers
  // edit, and sits on a DNS record made separately — `catalogue` is a proxied
  // AAAA to the discard prefix `100::`, which the edge never contacts because
  // this route answers the request before an origin is ever chosen.
  //
  // `workers.dev` is OFF, and it could only be turned off now.
  // `EXPO_PUBLIC_CATALOGUE_URL` is inlined into the bundle at export time, so a
  // build already on somebody's phone goes on asking for whatever hostname it
  // was built against, whatever we do here. That set is empty today: nothing
  // has shipped, and a dev client takes its JS from Metro or from an
  // `eas update` on a channel that still receives them, so an update moves it.
  // The first build to reach a store ends that for good, and this hostname
  // would then have to stay open for as long as anybody declined to upgrade.
  //
  // `preview_urls` stays, and stays EXPLICIT. It defaults to whatever
  // `workers_dev` is, so turning one off silently takes the other with it — and
  // preview URLs are what `versions upload --preview-alias pr-N` hands to a
  // PR's `eas update`. Wrangler mentions that default only in a warning printed
  // after the upload has already landed, which is how it was learnt: the first
  // deploy of this route turned `workers.dev` off and took the catalogue away
  // from every installed build, and the second turned preview URLs off.
  "routes": [{ "pattern": "catalogue.ricecal.app/*", "zone_name": "ricecal.app" }],
  "workers_dev": false,
  "preview_urls": true,
  // Which project's JWTs to accept. A public URL rather than a secret — the
  // key that verifies them is public too, published at that host's JWKS
  // endpoint. See `src/auth.ts`.
  "vars": {
    "SUPABASE_URL": "https://wgybijmprafqkshmmxdl.supabase.co"
  },
  // What stops an account being a licence to copy the catalogue. Keyed by user
  // id, and sized for somebody typing rather than browsing: search fires once
  // per keystroke, so a real person spends ten or so in a burst.
  //
  // PUBLIC_RL is the same idea for a caller with no account to key on: the
  // marketing site's preview search, which is anonymous by design. Keyed on
  // `cf-connecting-ip` instead, and a fifth of the allowance, because an IP is a
  // far weaker identity than a user id — one office shares one, and a phone
  // changes its own by walking outside.
  //
  // Twenty is not twenty keystrokes. A cache hit returns before the limiter is
  // ever consulted, so this governs DISTINCT queries a minute, and a person
  // hunting for one dish sends far fewer of those than they type.
  //
  // A SECOND NAMESPACE rather than a second key into the first, so that an
  // anonymous flood cannot spend the app's budget. Sharing 1001 would have made
  // the marketing site able to rate-limit paying users out of search.
  "ratelimits": [
    {
      "name": "CATALOGUE_RL",
      "namespace_id": "1001",
      "simple": { "limit": 100, "period": 60 }
    },
    {
      "name": "PUBLIC_RL",
      "namespace_id": "1002",
      "simple": { "limit": 20, "period": 60 }
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ricecal-d1-food-catalogue",
      "database_id": "2b49b52a-f908-41c0-8433-c6933fb19c65"
    }
  ]
  // No named environments, deliberately. A PR gets a VERSION of this same
  // Worker under an alias (`wrangler versions upload --preview-alias pr-42`),
  // which takes 0% of production traffic and inherits every binding above — so
  // a preview reads the real 3.2 million packets, and there is no second script
  // to keep in step, no second set of bindings to forget, and nothing to delete
  // when the PR closes.
}
