{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ricecal-catalogue",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  // The catalogue is read-only and read-heavy, so the Worker wants to run where
  // the data is rather than where the caller is. The database was created with
  // the APAC location hint; Smart Placement moves the Worker to meet it.
  "placement": { "mode": "smart" },
  "observability": { "enabled": true },
  // Which project's JWTs to accept. A public URL rather than a secret — the
  // key that verifies them is public too, published at that host's JWKS
  // endpoint. See `src/auth.ts`.
  "vars": {
    "SUPABASE_URL": "https://wgybijmprafqkshmmxdl.supabase.co"
  },
  // What stops an account being a licence to copy the catalogue. Keyed by user
  // id, and sized for somebody typing rather than browsing: search fires once
  // per keystroke, so a real person spends ten or so in a burst.
  "ratelimits": [
    {
      "name": "CATALOGUE_RL",
      "namespace_id": "1001",
      "simple": { "limit": 100, "period": 60 }
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ricecal-d1-food-catalogue",
      "database_id": "2b49b52a-f908-41c0-8433-c6933fb19c65"
    }
  ],
  // What the `preview` branch deploys, as `ricecal-catalogue-preview`. A second
  // script rather than a second database: the catalogue is READ-ONLY over HTTP
  // and there is one copy of it, so pointing preview at the same D1 is what
  // makes the environment worth having — it exercises the change against the
  // rows production actually serves, which a stub of 3.2 million packets could
  // not.
  //
  // Everything below is repeated rather than inherited, and that is wrangler's
  // rule rather than a style choice: a named environment inherits `main`,
  // `compatibility_date`, `placement` and `observability`, and inherits NO
  // bindings. Omitted, `DB` would simply not exist and every request would
  // fail at the first query.
  "env": {
    "preview": {
      "vars": {
        "SUPABASE_URL": "https://wgybijmprafqkshmmxdl.supabase.co"
      },
      "ratelimits": [
        {
          "name": "CATALOGUE_RL",
          "namespace_id": "1001",
          "simple": { "limit": 100, "period": 60 }
        }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "ricecal-d1-food-catalogue",
          "database_id": "2b49b52a-f908-41c0-8433-c6933fb19c65"
        }
      ]
    }
  }
}
