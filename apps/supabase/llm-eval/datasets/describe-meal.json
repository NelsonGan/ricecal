{
  "about": "A typed meal, answered by describeMeal (including keepDishesWhole) and folded by foldMealItems. kcal is a band for the midpoint of the model's own band. parts is the exact component count, or a [min, max] range. Most cases come from the old eval-prompts and eval:scan suites, where each one was a bug that shipped.",
  "cases": [
    {
      "id": "nasi-lemak",
      "input": { "text": "nasi lemak" },
      "expect": {
        "no_food": false,
        "name_has": ["nasi lemak"],
        "parts": 0,
        "count": 1,
        "kcal": [350, 700]
      }
    },
    {
      "id": "nasi-lemak-typo",
      "note": "A typo still finds the dish.",
      "input": { "text": "nasi lemk" },
      "expect": { "no_food": false, "name_has": ["lemak"], "parts": 0 }
    },
    {
      "id": "nasi-lemak-chicken-teh-tarik",
      "input": { "text": "nasi lemak with fried chicken and teh tarik" },
      "expect": {
        "no_food": false,
        "name_has": ["nasi lemak"],
        "parts": 3,
        "part_has": ["teh"],
        "kcal": [700, 1250]
      }
    },
    {
