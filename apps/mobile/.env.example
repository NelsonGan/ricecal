# Copy to .env.local and fill in. Every value here ships inside the JS bundle —
# EXPO_PUBLIC_ is not a secret namespace, it is the opposite of one.
#
# Service role keys, Gemini keys, and R2 credentials must NEVER appear in this
# file. They live in Supabase secrets, next to the Edge Function that uses them.
#
# Until a value is real, leave the REPLACE_ME placeholder in place: src/lib/env.ts
# treats a REPLACE_ME value as "not configured yet" and skips initialising that
# SDK, rather than crashing on a bogus key.

EXPO_PUBLIC_SUPABASE_URL=REPLACE_ME
EXPO_PUBLIC_SUPABASE_ANON_KEY=REPLACE_ME
EXPO_PUBLIC_CATALOGUE_URL=REPLACE_ME
EXPO_PUBLIC_RC_IOS_KEY=REPLACE_ME
EXPO_PUBLIC_RC_ANDROID_KEY=REPLACE_ME
# RevenueCat's test store, for walking the purchase flow on a simulator.
# Development builds only — a release bundle cannot read it. Leave it out
# entirely to buy through the real store. See EXPO_PUBLIC_RC_TEST_STORE_KEY in
# src/lib/env.ts, and REVENUECAT_SANDBOX_USER_IDS on the edge functions.
# EXPO_PUBLIC_RC_TEST_STORE_KEY=
EXPO_PUBLIC_MIXPANEL_TOKEN=REPLACE_ME
EXPO_PUBLIC_SENTRY_DSN=REPLACE_ME
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=REPLACE_ME
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=REPLACE_ME

# Cloudflare Turnstile, the bot gate in front of Supabase's auth endpoints.
# The SITE key is public by design: it names the widget and proves nothing. The
# secret half is Supabase's and is set with `pnpm auth:config --captcha-secret`.
#
# The origin is the hostname the widget is registered against on Cloudflare. A
# WebView rendering inline HTML has no hostname of its own, so the page is
# loaded under this one; it must be in the widget's allowed list, and nothing is
# ever fetched from it.
#
# Left at REPLACE_ME the app asks for no token and sends none, which is right
# while the gate on the project is off. Turn the gate on only once a build
# carrying a real key is the one people are running.
EXPO_PUBLIC_TURNSTILE_SITE_KEY=REPLACE_ME
EXPO_PUBLIC_TURNSTILE_ORIGIN=ricecal.app
