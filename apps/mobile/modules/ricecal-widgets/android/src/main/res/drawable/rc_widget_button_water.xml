<?xml version="1.0" encoding="utf-8"?>
<!-- A squishy button, as far as a widget can take one: the slab is a second
     rectangle four points down rather than a blur, and there is no press state
     because the launcher owns the touch. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
  <item android:top="4dp">
    <shape android:shape="rectangle">
      <corners android:radius="12dp" />
      <solid android:color="@color/rc_water_slab" />
    </shape>
  </item>
  <item android:bottom="4dp">
    <shape android:shape="rectangle">
      <corners android:radius="12dp" />
      <solid android:color="@color/rc_water" />
    </shape>
  </item>
</layer-list>
