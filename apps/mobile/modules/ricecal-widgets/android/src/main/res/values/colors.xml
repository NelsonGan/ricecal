<?xml version="1.0" encoding="utf-8"?>
<!--
  The design system's colours, for a process that cannot import it.

  A hand-copied subset of `src/theme/tokens.ts` — only the roles the six widgets
  draw with. Copied rather than generated because a widget is inflated by the
  launcher from compiled resources, and because the list is short enough that a
  drift is visible in a screenshot.

  The dark twin is in `values-night/`, and the system picks between them by the
  launcher's configuration. See the note at the foot of `WidgetSnapshot.kt` for
  why the app's own light/dark preference does not override that here.
-->
<resources>
  <color name="rc_surface">#FFFFFF</color>
  <color name="rc_track">#EDF1EE</color>
  <color name="rc_ink">#1C2321</color>
  <color name="rc_heading">#1B3A2B</color>
