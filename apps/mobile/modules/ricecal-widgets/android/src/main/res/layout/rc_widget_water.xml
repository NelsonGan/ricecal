<?xml version="1.0" encoding="utf-8"?>
<!--
  SMALL · WATER — the one widget that logs something rather than pointing at it.

  The two presets are real buttons here, on every Android version this app
  supports, because a widget's click targets have never been limited the way a
  `systemSmall` WidgetKit widget's are. They broadcast to `WaterActionReceiver`,
  which writes to the same store and redraws; the app is never launched.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:orientation="vertical"
  android:background="@drawable/rc_widget_card"
  android:padding="16dp">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical">

    <TextView
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:fontFamily="@font/rc_nunito_extrabold"
      android:textSize="11sp"
      android:letterSpacing="0.08"
      android:textColor="@color/rc_faint"
      android:text="WATER" />

    <TextView
      android:id="@+id/rc_water_goal"
      android:layout_width="0dp"
      android:layout_weight="1"
      android:layout_height="wrap_content"
      android:layout_marginStart="4dp"
      android:gravity="end"
      android:maxLines="1"
      android:fontFamily="@font/rc_nunito_extrabold"
      android:textSize="10sp"
      android:textColor="@color/rc_muted"
      android:text="of 2,000 ml" />
  </LinearLayout>

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:baselineAligned="true">

    <TextView
      android:id="@+id/rc_water_value"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:fontFamily="@font/rc_baloo2_extrabold"
      android:textSize="34sp"
      android:includeFontPadding="false"
      android:maxLines="1"
      android:textColor="@color/rc_heading"
      android:text="1,250" />

    <TextView
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="4dp"
      android:fontFamily="@font/rc_nunito_extrabold"
      android:textSize="12sp"
      android:textColor="@color/rc_muted"
      android:text="ml" />
  </LinearLayout>

  <ProgressBar
    android:id="@+id/rc_water_bar"
    style="?android:attr/progressBarStyleHorizontal"
    android:layout_width="match_parent"
    android:layout_height="16dp"
    android:layout_marginTop="12dp"
    android:minHeight="14dp"
    android:maxHeight="14dp"
    android:progressDrawable="@drawable/rc_bar_water" />

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="52dp"
    android:layout_marginTop="14dp"
    android:orientation="horizontal">

    <TextView
      android:id="@+id/rc_water_add_250"
      android:layout_width="0dp"
      android:layout_weight="1"
      android:layout_height="match_parent"
      android:gravity="center"
      android:background="@drawable/rc_widget_button_water"
      android:fontFamily="@font/rc_baloo2_extrabold"
      android:textSize="16sp"
      android:textColor="@color/rc_on_water"
      android:text="+250" />

    <TextView
      android:id="@+id/rc_water_add_500"
      android:layout_width="0dp"
      android:layout_weight="1"
      android:layout_height="match_parent"
      android:layout_marginStart="6dp"
      android:gravity="center"
      android:background="@drawable/rc_widget_button_water"
      android:fontFamily="@font/rc_baloo2_extrabold"
      android:textSize="16sp"
      android:textColor="@color/rc_on_water"
      android:text="+500" />
  </LinearLayout>
</LinearLayout>
