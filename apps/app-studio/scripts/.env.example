# Credentials do NOT live here.
#
# Uploads run through the `asc` and `gplay` CLIs, which hold their own:
#   asc    App Store Connect API key, in the macOS keychain   →  asc auth login
#   gplay  Play service account JSON, under ~/.gplay          →  gplay setup
#
# Check both with `asc doctor` and `gplay doctor`. All this file has to say is
# which app the CLIs should write to.

# Numeric App ID from App Store Connect, not the bundle id com.nelsongan.ricecal.
# It is the number in the URL: appstoreconnect.apple.com/apps/6795558595
ASC_APP_ID=6795558595

# Play package name, the same as applicationId in the Expo config.
ANDROID_PACKAGE_NAME=com.nelsongan.ricecal
