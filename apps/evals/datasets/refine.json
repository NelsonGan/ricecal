{
  "about": "A typed correction against one logged entry, answered by interpretInstruction (including its one retry on an unusable answer). `context` names an entry in `contexts`. Most cases come from the old eval-prompts and eval:refine suites.",
  "contexts": {
    "PLATE": {
      "name": "Nasi lemak with fried chicken",
      "kcal": 780,
      "quantity": 1,
      "servingLabel": "1 plate",
      "ingredients": [
        { "name": "coconut rice", "quantity": 1, "kcal": 340 },
        { "name": "fried chicken wing", "quantity": 2, "kcal": 250 },
        { "name": "sambal", "quantity": 1, "kcal": 60 },
        { "name": "boiled egg", "quantity": 1, "kcal": 70 }
      ]
    },
    "PORK": {
      "name": "Pork chop with rice and vegetables",
      "kcal": 700,
      "quantity": 1,
      "servingLabel": "1 plate",
      "ingredients": [
        { "name": "Grilled pork chop", "quantity": 1, "kcal": 350 },
        { "name": "Steamed rice", "quantity": 1, "kcal": 260 },
        { "name": "Mixed vegetables", "quantity": 1, "kcal": 90 }
      ]
    },
    "SATAY": {
      "name": "Chicken satay with peanut sauce and ketupat",
      "kcal": 520,
      "quantity": 1,
      "servingLabel": "1 set",
      "ingredients": [
        { "name": "Chicken satay stick", "quantity": 6, "kcal": 240 },
        { "name": "Peanut sauce", "quantity": 1, "kcal": 180 },
        { "name": "Ketupat", "quantity": 1, "kcal": 100 }
      ]
    },
    "DRINK": {
      "name": "Teh tarik",
      "kcal": 180,
      "quantity": 1,
      "servingLabel": "1 glass",
      "ingredients": []
    },
    "DISH": {
      "name": "Char kuey teow",
      "kcal": 620,
      "quantity": 1,
      "servingLabel": "1 plate",
      "ingredients": []
    },
    "DOUBLE": {
      "name": "Roti canai",
      "kcal": 600,
      "quantity": 2,
      "servingLabel": "1 piece",
      "ingredients": []
    },
    "LAKSA": {
      "name": "Curry laksa",
      "kcal": 650,
      "quantity": 1,
      "servingLabel": "1 bowl",
      "ingredients": []
    }
  },
  "cases": [
    {
      "id": "pork-to-chicken-not-but",
      "input": { "context": "PORK", "text": "This is not pork chop, but chicken" },
      "expect": {
        "action": "adjust",
        "replaces": "Grilled pork chop",
        "part_has": "chicken",
        "part_lacks": "pork",
        "name_lacks": ["pork"]
      }
    },
    {
      "id": "pork-to-chicken-y-not-x",
      "input": { "context": "PORK", "text": "This is chicken, not pork chop" },
      "expect": {
        "action": "adjust",
        "replaces": "Grilled pork chop",
        "part_has": "chicken",
        "part_lacks": "pork",
        "name_lacks": ["pork"]
      }
    },
    {
      "id": "pork-to-chicken-replace",
      "input": { "context": "PORK", "text": "Replace the pork chop with chicken" },
      "expect": {
        "action": "adjust",
        "replaces": "Grilled pork chop",
        "part_has": "chicken",
        "part_lacks": "pork",
        "name_lacks": ["pork"]
      }
    },
    {
      "id": "pork-to-chicken-same-amount",
      "input": { "context": "PORK", "text": "Not pork, chicken. Same amount." },
      "expect": {
        "action": "adjust",
        "replaces": "Grilled pork chop",
        "part_has": "chicken",
        "part_lacks": "pork",
        "name_lacks": ["pork"]
      }
    },
    {
      "id": "pork-to-chicken-calories-same",
      "note": "An identity correction matters even when the calories are unchanged.",
      "input": {
        "context": "PORK",
        "text": "It was chicken instead of pork, the calories are the same"
      },
      "expect": {
        "action": "adjust",
        "replaces": "Grilled pork chop",
        "part_has": "chicken",
        "part_lacks": "pork"
      }
    },
    {
      "id": "pork-to-chicken-malay",
      "input": { "context": "PORK", "text": "Ini bukan pork chop, ini ayam" },
      "expect": {
        "action": "adjust",
        "replaces": "Grilled pork chop",
        "part_has": "chicken|ayam",
        "part_lacks": "pork"
      }
    },
    {
      "id": "pork-to-chicken-chinese",
      "input": { "context": "PORK", "text": "这不是猪排，是鸡肉" },
      "expect": {
        "action": "adjust",
        "replaces": "Grilled pork chop",
        "part_has": "chicken|鸡",
        "part_lacks": "pork|猪"
      }
    },
    {
      "id": "no-mixed-vegetables",
      "input": { "context": "PORK", "text": "no mixed vegetables" },
      "expect": { "action": "adjust", "part_has": "vegetable", "delta": [-120, -60] }
    },
    {
      "id": "half-portion",
      "input": { "context": "PLATE", "text": "half portion" },
      "expect": { "action": "quantity", "factor": [0.49, 0.51] }
    },
    {
      "id": "ate-half-of-it",
      "input": { "context": "DISH", "text": "I only ate half of it" },
      "expect": { "action": "quantity", "factor": [0.45, 0.55] }
    },
    {
      "id": "two-plates",
      "input": { "context": "DISH", "text": "I had two plates" },
      "expect": { "action": "quantity", "factor": [1.99, 2.01] }
    },
    {
      "id": "two-in-total-already-two",
      "note": "'Two of these' means two in total; the entry already holds two, so the factor is 1 or the answer is none.",
      "input": { "context": "DOUBLE", "text": "I had two of these" },
      "expect": { "action": ["quantity", "none"] }
    },
    {
      "id": "three-in-total-from-two",
      "note": "Three in total from a logged quantity of two is a factor of 1.5.",
      "input": { "context": "DOUBLE", "text": "actually I had 3 roti" },
      "expect": { "action": "quantity", "factor": [1.45, 1.55] }
    },
    {
      "id": "stated-total-is-quantity",
      "note": "A calorie total for the whole dish is an amount: 500/780 = 0.64.",
      "input": { "context": "PLATE", "text": "this was more like 500 calories" },
      "expect": { "action": "quantity", "factor": [0.56, 0.72] }
    },
    {
      "id": "make-it-800",
      "input": { "context": "DISH", "text": "make it 800 calories" },
      "expect": { "action": "quantity", "factor": [1.19, 1.39] }
    },
    {
      "id": "no-sambal",
      "input": { "context": "PLATE", "text": "no sambal" },
      "expect": { "action": "adjust", "part_has": "sambal", "delta": [-150, -1] }
    },
    {
      "id": "no-sambal-typo",
      "input": { "context": "PLATE", "text": "no smabal" },
      "expect": { "action": "adjust", "part_has": "sambal", "delta": [-150, -1] }
    },
    {
      "id": "add-fried-egg",
      "input": { "context": "PLATE", "text": "add a fried egg" },
      "expect": { "action": "adjust", "part_has": "egg", "delta": [50, 250] }
    },
    {
      "id": "only-one-wing",
      "input": { "context": "PLATE", "text": "only 1 chicken wing" },
      "expect": { "action": "adjust", "part_has": "chicken|wing", "total": 1 }
    },
    {
      "id": "two-more-wings",
      "input": { "context": "PLATE", "text": "two more wings" },
      "expect": { "action": "adjust", "part_has": "wing", "count": 2 }
    },
    {
      "id": "left-half-the-rice",
      "input": { "context": "PLATE", "text": "i left half the rice" },
      "expect": { "action": "adjust", "part_has": "rice", "delta": [-290, -50] }
    },
    {
      "id": "extra-rice",
      "input": { "context": "PLATE", "text": "extra rice" },
      "expect": { "action": "adjust", "part_has": "rice", "delta": [1, 400] }
    },
    {
      "id": "double-the-rice",
      "input": { "context": "PLATE", "text": "double the rice" },
      "expect": { "action": "adjust", "part_has": "rice", "delta": [1, 400] }
    },
    {
      "id": "add-teh-tarik",
      "input": { "context": "PLATE", "text": "add a teh tarik" },
      "expect": { "action": "adjust", "part_has": "teh", "delta": [40, 220] }
    },
    {
      "id": "rendang-not-fried",
      "note": "A part changed identity: still the same plate. Priced absolutely, rendang chicken is not cheaper than a fried wing.",
      "input": { "context": "PLATE", "text": "it was rendang chicken not fried chicken" },
      "expect": {
        "action": "adjust",
        "part_has": "rendang",
        "part_kcal": [200, 450],
        "name_has": ["nasi lemak"]
      }
    },
    {
      "id": "duck-not-chicken",
      "note": "The old failure copied the old name into part as well as replaces.",
      "input": { "context": "PLATE", "text": "it was duck rice not the chicken" },
      "expect": { "action": "adjust", "part_has": "duck", "part_lacks": "^fried chicken wing$" }
    },
    {
      "id": "grilled-not-fried",
      "input": { "context": "PLATE", "text": "the chicken was grilled not fried" },
      "expect": {
        "action": "adjust",
        "part_has": "grilled",
        "part_kcal": [100, 249],
        "name_has": ["nasi lemak"]
      }
    },
    {
      "id": "egg-fried-not-boiled",
      "input": { "context": "PLATE", "text": "the egg was fried not boiled" },
      "expect": { "action": "adjust", "part_has": "egg", "part_kcal": [75, 140] }
    },
    {
      "id": "no-chicken",
      "input": { "context": "PLATE", "text": "no chicken" },
      "expect": { "action": "adjust", "part_has": "chicken", "delta": [-260, -200] }
    },
    {
      "id": "no-rice-just-chicken",
      "input": { "context": "PLATE", "text": "there was no rice, just the chicken and sambal" },
      "expect": { "action": "adjust", "part_has": "rice", "delta": [-360, -300] }
    },
    {
      "id": "no-cockles-unbroken-dish",
      "input": { "context": "DISH", "text": "no cockles" },
      "expect": { "action": "adjust", "delta": [-150, -10] }
    },
    {
      "id": "add-egg-unbroken-dish",
      "input": { "context": "DISH", "text": "add an egg" },
      "expect": { "action": "adjust", "part_has": "egg", "delta": [50, 130] }
    },
    {
      "id": "add-two-satay",
      "input": { "context": "PLATE", "text": "add 2 satay sticks" },
      "expect": { "action": "adjust", "part_has": "satay", "count_or_total": 2 }
    },
    {
      "id": "only-three-satay",
      "note": "'Only N' is a total, never a count.",
      "input": { "context": "SATAY", "text": "only 3 sticks" },
      "expect": { "action": "adjust", "part_has": "satay", "total": 3 }
    },
    {
      "id": "no-peanut-sauce",
      "input": { "context": "SATAY", "text": "no kuah kacang" },
      "expect": { "action": "adjust", "part_has": "peanut", "delta": [-200, -150] }
    },
    {
      "id": "kurang-manis",
      "note": "Less sugar takes calories out of a sweet drink.",
      "input": { "context": "DRINK", "text": "kurang manis" },
      "expect": { "action": "adjust", "delta": [-140, -20] }
    },
    {
      "id": "no-santan-laksa",
      "input": { "context": "LAKSA", "text": "no santan" },
      "expect": { "action": "adjust", "delta": [-250, -60] }
    },
    {
      "id": "hokkien-mee-instead",
      "input": { "context": "DISH", "text": "it was actually hokkien mee" },
      "expect": { "action": "redescribe", "name_has": ["hokkien"] }
    },
    {
      "id": "nasi-kandar-not-lemak",
      "input": { "context": "PLATE", "text": "this is nasi kandar not nasi lemak" },
      "expect": { "action": "redescribe", "name_has": ["kandar"] }
    },
    {
      "id": "extra-spicy-is-none",
      "input": { "context": "PLATE", "text": "extra spicy" },
      "expect": { "action": "none" }
    },
    {
      "id": "no-ice-is-none",
      "input": { "context": "DRINK", "text": "no ice" },
      "expect": { "action": "none" }
    },
    {
      "id": "it-was-tasty-is-none",
      "input": { "context": "DISH", "text": "it was really tasty" },
      "expect": { "action": "none" }
    },
    {
      "id": "reminder-is-none",
      "input": { "context": "DISH", "text": "remind me to buy milk" },
      "expect": { "action": "none" }
    },
    {
      "id": "half-portion-typo",
      "input": { "context": "DISH", "text": "hlaf portion" },
      "expect": { "action": "quantity", "factor": [0.45, 0.55] }
    },
    {
      "id": "shared-with-wife",
      "input": { "context": "DISH", "text": "I shared it with my wife" },
      "expect": { "action": "quantity", "factor": [0.45, 0.55] }
    },
    {
      "id": "three-plates-not-one",
      "input": { "context": "DISH", "text": "it was 3 plates not 1" },
      "expect": { "action": "quantity", "factor": [2.95, 3.05] }
    },
    {
      "id": "half-the-wings",
      "note": "Half of a listed ingredient is that part's total, never a rescale of the meal.",
      "input": { "context": "PLATE", "text": "only half the chicken" },
      "expect": { "action": "adjust", "part_has": "chicken|wing" }
    }
  ]
}
