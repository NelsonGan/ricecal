node_modules
.env
# Trailing glob on purpose: .env.local.cloud-backup and
# .env.local.localstack-backup hold real keys, and a bare `.env.local` does not
# match them.
.env.local*
.expo
dist
.turbo

# Signing material and private keys. .secrets/ is ignored wholesale rather than
# by extension, so a key with an unexpected name cannot slip through. The
# extension rules below are a second line of defence for files placed elsewhere.
#
# Nothing here is recoverable if leaked -- an App Store Connect .p8 is issued
# once and grants API access to the whole team.
.secrets/
*.p8
*.p12
*.jks
*.keystore
*.mobileprovision
*.cer
*.certSigningRequest

# Continuous Native Generation: ios/ and android/ are build output from
# `expo prebuild`, never edited by hand. Anchored to the app dir so a source
# directory that happens to be named `ios` or `android` is not swallowed.
/apps/*/ios
/apps/*/android

# A local Expo module keeps its SOURCE under `modules/`, which is tracked — but
# Gradle drops its own output next to it, and biome reads this file, so a build
# left the checks failing on a generated `navigation.json`.
/apps/*/modules/*/android/build
/apps/*/modules/*/android/.gradle
/apps/*/modules/*/android/.cxx

# Build artifacts
*.tsbuildinfo
coverage
*.log

# Supabase local dev
apps/supabase/.branches
apps/supabase/.temp
# The CLI writes its scratch state next to the CWD, not next to `--workdir`, so
# a command run from the repo root leaves a second one of these here. Biome
# reads this file, and an unformatted `linked-project.json` fails `pnpm check`
# for reasons that have nothing to do with the change being checked.
/supabase/

# macOS
.DS_Store

# Editors
.idea/
.vscode/

# Written by whichever Deno command runs the prompt eval harness. CI checks the
# edge functions with `--no-lock` for the reason in CLAUDE.md — a lockfile that
# reaches a function directory gets bundled into the deployed script.
deno.lock

# Wrangler's local-mode scratch state. `wrangler r2 ...` defaults to a LOCAL
# simulated bucket and writes one of these next to the CWD; every real command
# here needs `--remote`, and nothing in this directory is ever the truth.
.wrangler/

# What `wrangler dev` loads instead of the deployed secrets. The jobs Worker's
# copy holds a service-role key — the local stack's, which is a published
# constant, but the file is the same shape as one holding production's and the
# habit is what matters.
.dev.vars
.dev.vars.*

# Photographs the scan eval fetches from their source URLs. The cases carry
# the URL; this is only the copy.
apps/supabase/data/scan-eval/.cache/

# The photo benchmark's plates. Somebody's actual lunch, photographed on their
# own phone, so the images stay out of the repo and only the reference figures
# and what was seen in each are committed. See `photo-bench.mjs`.
apps/supabase/data/photo-bench/

# The researched dish payloads and the reports a load writes.
#
# These are the INPUT to the catalogue, and the catalogue is not in this repo —
# it is in Cloudflare D1, rebuilt from these files plus the barcode dump. They
# are five megabytes of JSON that no build, test or CI job reads, and every one
# of them has already been loaded; keeping them tracked put a quarter of a
# million lines of data in front of every code review of this repo.
#
# The format is documented in the README beside them, which stays tracked.
apps/supabase/data/foods/*.json
apps/supabase/data/foods/.reports/
apps/supabase/data/foods/aliases/
