--- a/cpp/core/Promise.cpp
+++ b/cpp/core/Promise.cpp
@@ -11,8 +11,12 @@ namespace margelo::nitro {
 
 Promise<void>::~Promise() {
   if (isPending()) [[unlikely]] {
-    std::runtime_error error("Timeouted: Promise<void> was destroyed!");
-    reject(std::make_exception_ptr(error));
+    // Not std::make_exception_ptr: with Xcode 27's libc++ it links a symbol that only iOS 18+ has, so dyld kills the app at launch on older iOS (margelo/nitro#1652).
+    try {
+      throw std::runtime_error("Timeouted: Promise<void> was destroyed!");
+    } catch (...) {
+      reject(std::current_exception());
+    }
   }
 }
 
