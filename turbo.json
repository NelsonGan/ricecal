{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": [
    "SUPABASE_PROJECT_ID",
    "SUPABASE_ACCESS_TOKEN",
    // The Cloudflare Worker that serves the food catalogue, and the shared token
    // the Supabase functions call it with. Read by the search gate; the app
    // itself never sees the token, which is the whole reason the `catalogue`
    // edge function exists.
    "CATALOGUE_URL",
    "CATALOGUE_TOKEN",
    // Which D1 database the catalogue scripts talk to. Named rather than
    // hardcoded so a rehearsal can point at a copy, since D1 has no equivalent
    // of the local Supabase stack to practise a load against.
    "CATALOGUE_D1",
    // The two ways `eval:scan` and `eval:recipe` get a session now that captcha
    // is on and password sign-in is refused: a token handed straight in, or the
    // service-role key they can mint one with. See `otpToken` in
    // `apps/supabase/scripts/lib/live.mjs`.
    "EVAL_ACCESS_TOKEN",
    "SUPABASE_SERVICE_ROLE_KEY",
    // The read-only PostHog key `prompts:check` compares the hosted prompts
    // with, the same one the edge functions read them with.
    "POSTHOG_PROMPTS_API_KEY"
  ],
  // Not in Turbo's own hash, and both change what a task sees: the workspace
  // file sets how Babel's plugins are hoisted, the other the Node that runs it.
  "globalDependencies": ["pnpm-workspace.yaml", ".node-version"],
  "tasks": {
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    // Tests read files outside their package: the app's and the website's the
    // analytics tables in the root README, the app's nutrition test the SQL
    // schemas. Without them here an edit to one replays a cached pass.
    //
    // `^test` is there for the same reason rather than for the order: a task's
    // hash covers its own package and the tasks it depends on, nothing else, so
    // without it an edit to `packages/shared` replayed the app's cached pass.
    // CI keeps this cache between runs (`deploy.yml`), so a file a task reads
    // and this does not name is a check that silently stops running. A package
    // that reaches outside itself says so in its own `turbo.json`, as the jobs
    // Worker does.
    "test": {
      "dependsOn": ["^test"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/README.md",
        "$TURBO_ROOT$/apps/supabase/schemas/**"
      ]
    },
    // Only the website has a `lint` script: its ESLint rules stand in for the
    // ones eslint-config-next would apply. Everything else is linted by the root
    // Biome pass, which skips apps/web and apps/app-studio.
    "lint": {}
  }
}
